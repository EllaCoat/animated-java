# TODO - Move all internal functions into an internal namespace, and only have user-facing functions in the main `animated_java:<%export_namespace%>` namespace.

function on_load {
	data modify storage <%project_storage%> rig_hash set value <%"'" + rig_hash + "'"%>

	IF (tsb_optimized_export) {
		# TSB Optimized Export : on_load では cleanup を呼ばない (load 中サーバ再起動 / 戦闘中 reload で
		# プレイヤーの進行を巻き戻す危険があるため)。 cleanup は datapack disable 直前に
		# ボス制御 mcfunction から手動で呼ぶ運用に統一。 詳細は
		# docs/tsb-known-issues/cleanup-on-load-removed.md。
		# anim NBT は on_load では展開せず、 段階展開キュー経由でロード。
		# 既存ストレージへの set value は単純上書きなので残骸 cell があっても新 datapack の値で上書きされる。
	} ELSE IF (has_animations && use_storage_for_animation) {
		REPEAT (animations) as animation {
			data remove storage <%project_storage%>/animations <%animation.storage_name%>
		}
		<%animationStorage.join('\n')%>
	}

	IF (has_animations) {
		<%%
			animations.forEach(animation => {
				emit(`scoreboard objectives add ${OBJECTIVES.FRAME(animation.storage_name)} dummy`)
			})
		%%>
	}

	IF (tsb_optimized_export && has_animations) {
		# Phase C : bp 単位 objective 追加 (idempotent、 reload で重複実行されても無害)。
		# DUR / TP_DUR は interpolation_duration / teleportation_duration の scoreboard 管理化
		# (Phase A A-9)、 CURRENT_ANIM / FRAME_BP / BONE_ID / LOCATOR_ID は再生側集約 (Phase C 案 P / R)。
		# FRAME_BP は同時再生 1 anim まで前提の共通 frame counter。
		scoreboard objectives add <%OBJECTIVES.DUR(blueprint_id)%> dummy
		scoreboard objectives add <%OBJECTIVES.TP_DUR(blueprint_id)%> dummy
		scoreboard objectives add <%OBJECTIVES.CURRENT_ANIM(blueprint_id)%> dummy
		scoreboard objectives add <%OBJECTIVES.FRAME_BP(blueprint_id)%> dummy
		scoreboard objectives add <%OBJECTIVES.BONE_ID(blueprint_id)%> dummy
		scoreboard objectives add <%OBJECTIVES.LOCATOR_ID(blueprint_id)%> dummy

		# Blueprint Settings の interpolation_duration / teleportation_duration を score に書き込み。
		# reload で毎回再実行 = Settings 変更時の動的反映を兼ねる。
		# fakeplayer 名は `:` を `.` に置換 (objective 名と同じ理由)。
		scoreboard players set #<%blueprint_id.replace(':', '.')%> <%OBJECTIVES.DUR(blueprint_id)%> <%interpolation_duration%>
		scoreboard players set #<%blueprint_id.replace(':', '.')%> <%OBJECTIVES.TP_DUR(blueprint_id)%> <%teleportation_duration%>

		# Phase C 案 P : anim メタテーブルを on_load で同期書き込み (サイズ < 1KB、 遅延ロード不要)。
		# `aj.<bp>:meta d.anims[N]` = `{dur, lp, dly, hv, hl, (name?)}` を anim_id 順に list で配置。
		# `d.last_id` = anim 総数 - 1 (range check 用)。 debug_mode のときのみ各 entry に name フィールドを追加。
		# `hv` = has variant cells、 `hl` = has last_frame_effects (loop + delay=0 + 最終 frame に副作用) で
		# `_zzz_on_tick.mcfunction` の dispatch 判定に使う。
		<%%
			if (has_animations) {
				const animsList = animations.map(anim => {
					const lp = anim.loop_mode === 'once' ? 0 : anim.loop_mode === 'loop' ? 1 : 2
					const dly = anim.loop_delay || 0
					const hv = anim.frames.some(f => f.variants && f.variants.length > 0) ? 1 : 0
					const lastFrame = anim.frames[anim.frames.length - 1]
					const modifiedEffectNodes = lastFrame
						? Object.values(anim.modified_nodes).filter(
							n => n.type === 'locator' && lastFrame.node_transforms[n.uuid]
						)
						: []
					const hasLastFrameEffects =
						modifiedEffectNodes.length > 0 ||
						(lastFrame && lastFrame.variants && lastFrame.variants.length > 0) ||
						(lastFrame && lastFrame.function)
					const hl = (anim.loop_mode === 'loop' && dly === 0 && hasLastFrameEffects) ? 1 : 0
					const parts = [`dur:${anim.duration}`, `lp:${lp}b`, `dly:${dly}`, `hv:${hv}b`, `hl:${hl}b`]
					if (debug_mode) {
						parts.push(`name:"${anim.storage_name.replace(/"/g, '\\"')}"`)
					}
					return `{${parts.join(',')}}`
				})
				emit(`data modify storage ${project_storage.replace(':', '.')}:meta d.last_id set value ${animations.length - 1}`)
				emit(`data modify storage ${project_storage.replace(':', '.')}:meta d.anims set value [${animsList.join(',')}]`)
			}
		%%>

		# Phase C 案 V : variant 適用テーブルを on_load で同期書き込み (サイズ < 1KB)。
		# `aj.<bp>:meta d.variants.<variant>.<bone_id>` = `{cmd?: int, cfg?: compound}`、 影響しない
		# bone は path 不在 = no-op。 cleanup の `d` 配下 remove で消えるので残骸残りなし。
		<%%
			if (Object.keys(rig.variants).length > 0) {
				const filteredBones = Object.values(rig.nodes).filter(n => BONE_TYPES.includes(n.type))
				const variantParts = []
				for (const variant of Object.values(rig.variants)) {
					const bonePartsList = []
					filteredBones.forEach((node, i) => {
						let cmd = null
						if (
							node.type === 'bone' &&
							!variant.excluded_nodes.includes(node.uuid) &&
							variant.models[node.uuid] !== undefined
						) {
							const model = variant.models[node.uuid]
							cmd = model.model === null ? 1 : model.custom_model_data
						}
						let cfgNbt = null
						if (
							!variant.excluded_nodes.includes(node.uuid) &&
							node.configs.variants[variant.uuid] !== undefined
						) {
							const config = DisplayEntityConfig.fromJSON(node.configs.variants[variant.uuid])
							if (!config.isDefault()) {
								cfgNbt = config.toNBT(undefined, variant.is_default).toString()
							}
						}
						if (cmd === null && cfgNbt === null) return
						const parts = []
						if (cmd !== null) parts.push(`cmd:${cmd}`)
						if (cfgNbt !== null) parts.push(`cfg:${cfgNbt}`)
						bonePartsList.push(`"${i}":{${parts.join(',')}}`)
					})
					if (bonePartsList.length === 0) continue
					variantParts.push(`${variant.storage_name}:{${bonePartsList.join(',')}}`)
				}
				if (variantParts.length > 0) {
					emit(`data modify storage ${project_storage.replace(':', '.')}:meta d.variants set value {${variantParts.join(',')}}`)
				}
			}
		%%>

		# TSB Optimized Export : animation_hash 判定で reload 時のキュー再構築をスキップ。
		# 同一値の set value は throw + success 0 になる仕様
		# (`DataCommands.java::ERROR_MERGE_UNCHANGED`) を利用、 hash 変化時のみ init_queue。
		# 部分展開中 reload は hash 一致でスキップされるが、 残った queue は global tick の
		# load_dispatch_step が引き続き処理するため最終的に完全展開される。
		# datapack 入れ替え時の旧 storage 残骸は許容 (主に同じ cell の上書きで除去、
		# 一部 unreferenced cell は残るが運用上問題なし)。
		# 詳細 : docs/tsb-known-issues/reload-skip-on-hash-match.md
		execute store success score #h <%OBJECTIVES.I()%> run data modify storage <%project_storage.replace(':', '.')%>:state d.animation_hash set value "<%animation_hash%>"
		execute if score #h <%OBJECTIVES.I()%> matches 1 run function <%blueprint_id%>/load/init_queue
	}
}

IF (has_animations) {
	function remove_animation_objectives {
		<%%
			animations.forEach(animation => {
				emit(`scoreboard objectives remove ${OBJECTIVES.FRAME(animation.storage_name)}`)
			})
		%%>
		# TSB Optimized Export 配布ビルドでは UNINSTALL tellraw を抑制
		# (Blueprint Settings の `Silent Uninstall` チェックボックス、 default true)。
		# false にすると純正 AJ と同じ挙動 (tellraw でアンインストール完了をブロードキャスト)。
		IF (!tsb_silent_uninstall) {
			tellraw @a <%TELLRAW.UNINSTALL()%>
		}
	}
}

dir root {
	function on_tick {
		# Custom pre-tick function
		IF (on_pre_tick_function) {
			<%%
				emit.mcb(on_pre_tick_function)
			%%>
		}

		IF (has_animations) {
			IF (tsb_optimized_export) {
				# Phase C 集約 : current_anim score で再生中アニメを 1 個に絞り、 _zzz_on_tick を 1 回呼ぶ。
				# current_anim = -1 (停止) なら matches 0.. を抜けて何もしない (純正の pause_all + tag 削除 と等価)。
				execute if score @s <%OBJECTIVES.CURRENT_ANIM(blueprint_id)%> matches 0.. run block tick_animation {
					data remove storage <%project_storage.replace(':', '.')%>:tmp d.tmp
					execute store result storage <%project_storage.replace(':', '.')%>:tmp d.tmp.anim_id int 1 run scoreboard players get @s <%OBJECTIVES.CURRENT_ANIM(blueprint_id)%>
					function <%blueprint_id%>/animations/_zzz_on_tick with storage <%project_storage.replace(':', '.')%>:tmp d.tmp
				}
			} ELSE IF (animations.length > 8) {
				# animated_java:global/root/on_tick already runs this right before calling this function.
				# data_manager prep read

				# Once we have more than 8 animations, calling a function only if at least one animation is playing is more efficient.
				# If no animations are playing, we can skip all animation logic.
				# This helps reduce ticking commands for rigs that are idle.
				execute \
					unless entity @s[<%animations.map(anim => 'tag=!' + TAGS.ANIMATION_PLAYING(blueprint_id, anim.storage_name)).join(',')%>] \
				run block tick_animations {
					REPEAT (animations) as animation {
						execute if entity @s[tag=<%TAGS.ANIMATION_PLAYING(blueprint_id, animation.storage_name)%>] run \
							function <%blueprint_id%>/animations/<%animation.storage_name%>/zzz/on_tick
					}
				}
			} ELSE {
				REPEAT (animations) as animation {
					execute if entity @s[tag=<%TAGS.ANIMATION_PLAYING(blueprint_id, animation.storage_name)%>] run \
						function <%blueprint_id%>/animations/<%animation.storage_name%>/zzz/on_tick
				}
			}
		}

		IF (auto_update_rig_orientation) {
			IF (has_locators || has_cameras) {
				function <%blueprint_id%>/root/on_tick/transform_floating_entities
			}
			execute on passengers run tp @s ~ ~ ~ ~ ~
		} ELSE IF (has_ticking_locators) {
			function <%blueprint_id%>/root/on_tick/transform_locators
		}

		# Custom post-tick function
		IF (on_post_tick_function) {
			<%%
				emit.mcb(on_post_tick_function)
			%%>
		}
	}

	IF (has_locators || has_cameras) {
		dir on_tick {
			function transform_locators {
				REPEAT (Object.values(rig.nodes).filter(node => node.type === 'locator')) as locator {
					block select_locator_<%locator.storage_name%> { with storage <%temp_storage%> entry.data.locators.<%locator.storage_name%>
						IF (locator.config?.use_entity) {
							$execute \
								as $(uuid) \
								positioned ^$(px) ^$(py) ^$(pz) \
								rotated ~$(ry) ~$(rx) \
							run block as_locator_<%locator.storage_name%> {
								tp @s ~ ~ ~ ~ ~

								IF (locator.config?.sync_passenger_rotation) {
									execute on passengers run tp @s ~ ~ ~ ~ ~
								}

								IF (locator.config?.on_tick_function) {
									<%%
										emit.mcb(locator.config.on_tick_function)
									%%>
								}
							}
						} ELSE IF (locator.config?.on_tick_function) {
							$execute \
								positioned ^$(px) ^$(py) ^$(pz) \
								rotated ~$(ry) ~$(rx) \
							run block at_locator_<%locator.storage_name%> {
								<%%
									emit.mcb(locator.config.on_tick_function)
								%%>
							}
						}
					}
				}
			}

			function transform_floating_entities {
				function ./transform_locators

				REPEAT (Object.values(rig.nodes).filter(node => node.type === 'camera')) as camera {
					block select_camera_<%camera.storage_name%> { with storage <%temp_storage%> entry.data.cameras.<%camera.storage_name%>
						$execute \
							as $(uuid) \
							positioned ^$(px) ^$(py) ^$(pz) \
							rotated ~$(ry) ~$(rx) \
						run tp @s ~ ~ ~ ~ ~
					}
				}
			}
		}
	}
}

IF (!auto_update_rig_orientation) {
	function move {
		debug assert executed_as_root_entity <%TAGS.PROJECT_ROOT(blueprint_id)%>

		tp @s ~ ~ ~ ~ ~

		IF (has_locators || has_cameras) {
			data_manager prep read
			function <%blueprint_id%>/root/on_tick/transform_floating_entities
		}
		execute at @s on passengers run tp @s ~ ~ ~ ~ ~
	}
} ELSE {
	function move {
		tellraw @a <%TELLRAW.AUTO_UPDATE_RIG_ORIENTATION_MOVE_WARNING()%>
	}
}

IF (has_animations) {
	dir animations {

		IF (tsb_optimized_export) {
			# Phase C 案 P : アニメ別 N コピーを廃止して共通実装 + アニメ別 wrapper の二段構成に集約。
			# - 共通関数 : _play / _stop / _pause / _resume / _next_frame / _set_frame / _apply_frame / _tween
			#   + _zzz_on_tick / _zzz_set_frame / _zzz_apply_frame + _apply_one / _apply_bone / _apply_locator
			# - アニメ別 wrapper (UX 維持) : <anim>/play, stop, pause, resume, next_frame, set_frame,
			#   apply_frame, tween (各 1 行マクロで共通実装に anim_id を埋め込んで dispatch)
			#
			# 再生 state は score `aj.<bp>.current_anim` (-1=停止) + `aj.<bp>.frame` (bp 単位 1 個) の
			# 2 つで管理。 同時再生 1 anim まで前提 (pause/resume は同 anim_id 前提、 別 anim 切り替えなら
			# play で frame=0 リセット)。 純正の anim 別 FRAME / pause_all tag システムは廃止。

			function _play {
				# ARGS: {anim_id: int}
				# アニメ再生開始。 純正の play (line 199-209) 集約版。 frame=0 で transforms_only 経由で
				# 初期 pose を反映してから current_anim を set、 next tick から _zzz_on_tick が回る。
				debug assert executed_as_root_entity <%TAGS.PROJECT_ROOT(blueprint_id)%>

				$scoreboard players set @s <%OBJECTIVES.CURRENT_ANIM(blueprint_id)%> $(anim_id)
				scoreboard players set @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> 0
				tag @s add <%TAGS.TRANSFORMS_ONLY()%>
				$execute at @s run function <%blueprint_id%>/animations/_zzz_set_frame {anim_id: $(anim_id), frame: 0}
				tag @s remove <%TAGS.TRANSFORMS_ONLY()%>
			}

			function _stop {
				# ARGS: {anim_id: int}
				# アニメ停止。 current_anim = -1 で再生停止フラグ off、 frame = 0、 初期 pose 反映 (純正と同じ挙動)。
				debug assert executed_as_root_entity <%TAGS.PROJECT_ROOT(blueprint_id)%>

				scoreboard players set @s <%OBJECTIVES.CURRENT_ANIM(blueprint_id)%> -1
				scoreboard players set @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> 0
				tag @s add <%TAGS.TRANSFORMS_ONLY()%>
				$execute at @s run function <%blueprint_id%>/animations/_zzz_set_frame {anim_id: $(anim_id), frame: 0}
				tag @s remove <%TAGS.TRANSFORMS_ONLY()%>
			}

			function _pause {
				# 一時停止。 current_anim を -1 にして再生停止、 frame は維持 (同 anim_id を _resume で再開可能)。
				debug assert executed_as_root_entity <%TAGS.PROJECT_ROOT(blueprint_id)%>

				scoreboard players set @s <%OBJECTIVES.CURRENT_ANIM(blueprint_id)%> -1
			}

			function _resume {
				# ARGS: {anim_id: int}
				# 再生再開。 wrapper 経由で anim_id が埋め込まれて渡される (同 anim_id 前提、 frame は維持)。
				debug assert executed_as_root_entity <%TAGS.PROJECT_ROOT(blueprint_id)%>

				$scoreboard players set @s <%OBJECTIVES.CURRENT_ANIM(blueprint_id)%> $(anim_id)
			}

			function _next_frame {
				# ARGS: {anim_id: int}
				# 純正 next_frame (line 234-242) 集約版。 frame >= dur で frame=1 にリセット (純正と同じ動作)。
				# meta d.anims[anim_id].dur を score に展開して比較。
				debug assert executed_as_root_entity <%TAGS.PROJECT_ROOT(blueprint_id)%>

				$execute store result score #limit <%OBJECTIVES.I()%> run data get storage <%project_storage.replace(':', '.')%>:meta d.anims[$(anim_id)].dur
				execute if score @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> >= #limit <%OBJECTIVES.I()%> run scoreboard players set @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> 1
				data remove storage <%project_storage.replace(':', '.')%>:tmp d
				$data modify storage <%project_storage.replace(':', '.')%>:tmp d.anim_id set value $(anim_id)
				execute store result storage <%project_storage.replace(':', '.')%>:tmp d.frame int 1 run scoreboard players get @s <%OBJECTIVES.FRAME_BP(blueprint_id)%>
				execute at @s run function <%blueprint_id%>/animations/_zzz_apply_frame with storage <%project_storage.replace(':', '.')%>:tmp d
				scoreboard players add @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> 1
			}

			function _set_frame {
				# ARGS: {anim_id: int, frame: int}
				# frame 指定で transformation のみ更新 (interpolation なし)。 純正 line 244-254 集約版。
				debug assert executed_as_root_entity <%TAGS.PROJECT_ROOT(blueprint_id)%>

				data_manager prep read

				$scoreboard players set @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> $(frame)
				tag @s add <%TAGS.TRANSFORMS_ONLY()%>
				$execute at @s run function <%blueprint_id%>/animations/_zzz_set_frame {anim_id: $(anim_id), frame: $(frame)}
				tag @s remove <%TAGS.TRANSFORMS_ONLY()%>
			}

			function _apply_frame {
				# ARGS: {anim_id: int, frame: int}
				# frame 指定で transformation + variant + function keyframe をフル適用。 純正 line 256-265 集約版。
				debug assert executed_as_root_entity <%TAGS.PROJECT_ROOT(blueprint_id)%>

				data_manager prep read

				$scoreboard players set @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> $(frame)
				$execute at @s run function <%blueprint_id%>/animations/_zzz_apply_frame {anim_id: $(anim_id), frame: $(frame)}
			}

			function _tween {
				# ARGS: {anim_id: int, duration: int, to_frame: int}
				# 純正 tween (line 267-284) 集約版。 transforms_only で frame 0 → to_frame の補間遷移を作る。
				# tween_duration score で _zzz_on_tick の補間制御をオーバーライド。
				debug assert executed_as_root_entity <%TAGS.PROJECT_ROOT(blueprint_id)%>

				$scoreboard players set @s <%OBJECTIVES.CURRENT_ANIM(blueprint_id)%> $(anim_id)
				$scoreboard players set @s <%OBJECTIVES.TWEEN_DURATION()%> $(duration)
				$scoreboard players set @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> $(to_frame)

				scoreboard players operation #this <%OBJECTIVES.I()%> = @s <%OBJECTIVES.TWEEN_DURATION()%>
				tag @s add <%TAGS.TRANSFORMS_ONLY()%>
				$execute at @s run function <%blueprint_id%>/animations/_zzz_apply_frame {anim_id: $(anim_id), frame: 0}
				$execute at @s run function <%blueprint_id%>/animations/_zzz_apply_frame {anim_id: $(anim_id), frame: $(to_frame)}
				tag @s remove <%TAGS.TRANSFORMS_ONLY()%>
				execute on passengers store result entity @s interpolation_duration int 1 run scoreboard players get #this <%OBJECTIVES.I()%>
			}

			# アニメ別 wrapper (UX 維持)。 各 1 行マクロで共通実装に anim_id を埋め込んで dispatch する。
			# next_frame / play / stop / pause / resume は引数なし (anim_id 固定埋め込み)、
			# set_frame / apply_frame / tween は frame / duration / to_frame を macro で受け流す。
			REPEAT (animations.entries()) as animIndex, animation {
				dir <%animation.storage_name%> {
					function play {
						function <%blueprint_id%>/animations/_play {anim_id: <%animIndex%>}
					}
					function stop {
						function <%blueprint_id%>/animations/_stop {anim_id: <%animIndex%>}
					}
					function pause {
						function <%blueprint_id%>/animations/_pause
					}
					function resume {
						function <%blueprint_id%>/animations/_resume {anim_id: <%animIndex%>}
					}
					function next_frame {
						function <%blueprint_id%>/animations/_next_frame {anim_id: <%animIndex%>}
					}
					function set_frame {
						#ARGS: {frame: int}
						$function <%blueprint_id%>/animations/_set_frame {anim_id: <%animIndex%>, frame: $(frame)}
					}
					function apply_frame {
						#ARGS: {frame: int}
						$function <%blueprint_id%>/animations/_apply_frame {anim_id: <%animIndex%>, frame: $(frame)}
					}
					function tween {
						#ARGS: {duration: int, to_frame: int}
						$function <%blueprint_id%>/animations/_tween {anim_id: <%animIndex%>, duration: $(duration), to_frame: $(to_frame)}
					}
				}
			}

			# _lfx/<anim_id>.mcfunction (last_frame_effects)。 hl=1b の anim のみ生成 (= loop+delay=0+
			# 最終 frame に副作用持ち)。 _zzz_on_tick が frame=-1 のとき _lfx_dispatch 経由で呼ぶ。
			# 純正 last_frame_effects (1.20.4/main.mcb:401-443) のロジックを集約形に書き直し ;
			# locator function keyframe / variant 切替 / root function を最終 frame の状態で実行する。
			# 最終 frame の transformation 適用は cell から取れるため _lfx では行わない (frame=-1 の次 tick
			# で _zzz_apply_frame が frame=0 を apply、 _lfx 内では function keyframe 系のみ発火させる)。
			REPEAT (animations.entries()) as animIndex, animation {
				<%%
					const lastFrame = animation.frames[animation.frames.length - 1]
					const modifiedEffectNodes = lastFrame
						? Object.values(animation.modified_nodes).filter(
								n => n.type === 'locator' && lastFrame.node_transforms[n.uuid]
						  )
						: []
					const hasLastFrameEffects =
						modifiedEffectNodes.some(n => lastFrame.node_transforms[n.uuid].function) ||
						(lastFrame && lastFrame.variants && lastFrame.variants.length > 0) ||
						(lastFrame && lastFrame.function)
					global.shouldEmitLfx =
						animation.loop_mode === 'loop' &&
						(animation.loop_delay || 0) === 0 &&
						hasLastFrameEffects
					global.lfxLastFrame = lastFrame
					global.lfxEffectNodes = modifiedEffectNodes
				%%>
				IF (global.shouldEmitLfx) {
					dir _lfx {
						function <%animIndex%> {
							# locator function keyframe 発火 (純正 last_frame_effects の REPEAT 部分相当)。
							# 各 locator の position/rotation で execute → block 内に locator function を inline 展開。
							REPEAT (global.lfxEffectNodes) as node {
								<%%
									global.lfxTransform = global.lfxLastFrame.node_transforms[node.uuid]
								%%>
								IF (global.lfxTransform.function) {
									IF (node.config?.use_entity) {
										$execute \
											as $(<%node.storage_name%>) \
											positioned \
												^<%roundTo(global.lfxTransform.pos[0], 10)%> \
												^<%roundTo(global.lfxTransform.pos[1], 10)%> \
												^<%roundTo(global.lfxTransform.pos[2], 10)%> \
											rotated \
												~<%roundTo(global.lfxTransform.head_rot[1], 10)%> \
												~<%roundTo(global.lfxTransform.head_rot[0], 10)%> \
											<%global.lfxTransform.function_execute_condition ? global.lfxTransform.function_execute_condition + ' ' : ''%>run \
												block lfx_locator_<%node.storage_name%> {
													tp @s ~ ~ ~ ~ ~
													<%%
														emit.mcb(global.lfxTransform.function)
													%%>
												}
									} ELSE {
										execute \
											positioned \
												^<%roundTo(global.lfxTransform.pos[0], 10)%> \
												^<%roundTo(global.lfxTransform.pos[1], 10)%> \
												^<%roundTo(global.lfxTransform.pos[2], 10)%> \
											rotated \
												~<%roundTo(global.lfxTransform.head_rot[1], 10)%> \
												~<%roundTo(global.lfxTransform.head_rot[0], 10)%> \
											<%global.lfxTransform.function_execute_condition ? global.lfxTransform.function_execute_condition + ' ' : ''%>run \
												block lfx_locator_<%node.storage_name%> {
													<%%
														emit.mcb(global.lfxTransform.function)
													%%>
												}
									}
								}
							}

							# variant 切替 (集約版 _apply を直接呼ぶ、 wrapper バイパス)
							IF (global.lfxLastFrame.variants && global.lfxLastFrame.variants.length > 0) {
								<%%
									global.lfxVariant = rig.variants[global.lfxLastFrame.variants[0]]
								%%>
								execute <%global.lfxLastFrame.variants_execute_condition ? global.lfxLastFrame.variants_execute_condition + ' ' : ''%>run \
									function <%blueprint_id%>/variants/_apply {variant: "<%global.lfxVariant.storage_name%>"}
							}

							# root function keyframe (純正 line 525-530 相当)
							IF (global.lfxLastFrame.function) {
								execute <%global.lfxLastFrame.function_execute_condition ? global.lfxLastFrame.function_execute_condition + ' ' : ''%>run \
									block lfx_root_function {
										<%%
											emit.mcb(global.lfxLastFrame.function)
										%%>
									}
							}
						}
					}
				}
			}

			# Phase C 案 R : アニメ別 N コピーを廃止して共通 apply 関数で集約。 passenger コンテキストで
			# 呼ばれ、 bone_id / locator_id score (sentinel -1 でない方) で軸を選択。 path 不在
			# (このアニメで動かない bone/locator) は `if data storage` ガードで弾く。

			function _apply_one {
				# ARGS: {anim_id: int, frame: int, bone_id: int, locator_id: int}
				# passenger コンテキスト。 score check + path 存在チェックで該当 entity のみ apply。
				$execute if score @s <%OBJECTIVES.BONE_ID(blueprint_id)%> matches 0.. if data storage <%project_storage.replace(':', '.')%>:anim d.a_$(anim_id).bones.$(bone_id).$(frame) run function <%blueprint_id%>/animations/_apply_bone {anim_id: $(anim_id), frame: $(frame), bone_id: $(bone_id)}
				$execute if score @s <%OBJECTIVES.LOCATOR_ID(blueprint_id)%> matches 0.. if data storage <%project_storage.replace(':', '.')%>:anim d.a_$(anim_id).locators.$(locator_id).$(frame) run function <%blueprint_id%>/animations/_apply_locator {anim_id: $(anim_id), frame: $(frame), locator_id: $(locator_id)}
			}

			function _apply_bone {
				# ARGS: {anim_id: int, frame: int, bone_id: int}
				# bone passenger コンテキスト。 Phase A の 7/10/14 floats 純配列を Global API で
				# transformation compound に整形して entity に代入し、 interpolation_duration を反映。
				$data modify storage animated_java:global d.tmp.x set from storage <%project_storage.replace(':', '.')%>:anim d.a_$(anim_id).bones.$(bone_id).$(frame)
				function animated_java:global/transform_from_array
				data modify entity @s transformation set from storage animated_java:global d.tmp.transform
				execute store result entity @s interpolation_duration int 1 run scoreboard players get #<%blueprint_id.replace(':', '.')%> <%OBJECTIVES.DUR(blueprint_id)%>
			}

			function _apply_locator {
				# ARGS: {anim_id: int, frame: int, locator_id: int}
				# locator passenger コンテキスト。 Phase A の [5f] 固定配列 [px, py, pz, rot[0]=pitch, rot[1]=yaw] を
				# entity の Pos[0..2] / Rotation[0..1] に個別代入。 Rotation[0]=yaw, Rotation[1]=pitch のため
				# array index [4]→Rotation[0], [3]→Rotation[1] でクロス代入する。
				$data modify entity @s Pos[0] set from storage <%project_storage.replace(':', '.')%>:anim d.a_$(anim_id).locators.$(locator_id).$(frame)[0]
				$data modify entity @s Pos[1] set from storage <%project_storage.replace(':', '.')%>:anim d.a_$(anim_id).locators.$(locator_id).$(frame)[1]
				$data modify entity @s Pos[2] set from storage <%project_storage.replace(':', '.')%>:anim d.a_$(anim_id).locators.$(locator_id).$(frame)[2]
				$data modify entity @s Rotation[0] set from storage <%project_storage.replace(':', '.')%>:anim d.a_$(anim_id).locators.$(locator_id).$(frame)[4]
				$data modify entity @s Rotation[1] set from storage <%project_storage.replace(':', '.')%>:anim d.a_$(anim_id).locators.$(locator_id).$(frame)[3]
			}

			function _zzz_apply_frame {
				# ARGS: {anim_id: int, frame: int}
				# 案 R 集約版 : root context で anim_id/frame を tmp に書き込み、 passenger ループで
				# 各 passenger の bone_id/locator_id を tmp に転写してから _apply_one を with 渡しで呼ぶ。
				# variant 軸 dispatch (transforms_only tag なら skip、 frame に variant がある場合のみ)。
				data remove storage <%project_storage.replace(':', '.')%>:tmp d
				$data modify storage <%project_storage.replace(':', '.')%>:tmp d.anim_id set value $(anim_id)
				$data modify storage <%project_storage.replace(':', '.')%>:tmp d.frame set value $(frame)
				execute on passengers run block as_passenger {
					execute store result storage <%project_storage.replace(':', '.')%>:tmp d.bone_id int 1 run scoreboard players get @s <%OBJECTIVES.BONE_ID(blueprint_id)%>
					execute store result storage <%project_storage.replace(':', '.')%>:tmp d.locator_id int 1 run scoreboard players get @s <%OBJECTIVES.LOCATOR_ID(blueprint_id)%>
					function <%blueprint_id%>/animations/_apply_one with storage <%project_storage.replace(':', '.')%>:tmp d
				}

				# variant 軸 dispatch。 transforms_only tag (set_frame/tween から呼ばれた場合) なら skip。
				$execute unless entity @s[tag=<%TAGS.TRANSFORMS_ONLY()%>] if data storage <%project_storage.replace(':', '.')%>:variants d.a_$(anim_id).$(frame) run function <%blueprint_id%>/variants/_apply_at_frame with storage <%project_storage.replace(':', '.')%>:variants d.a_$(anim_id).$(frame)
			}

			function _zzz_set_frame {
				# ARGS: {anim_id: int, frame: int}
				# 純正 zzz/set_frame (line 338-343) 集約版。 frame 適用 + start_interpolation=-1 で瞬間反映。
				$function <%blueprint_id%>/animations/_zzz_apply_frame {anim_id: $(anim_id), frame: $(frame)}
				execute on passengers run data modify entity @s start_interpolation set value -1
				return 1
			}

			function _zzz_on_tick {
				# ARGS: {anim_id: int}  (root entity の on_tick から storage 経由で current_anim を流す)
				# 純正 zzz/on_tick (line 287-335) 集約版。 tween 制御 + last_frame_effects + apply +
				# loop/hold/once 判定を 1 関数で実施。 lp/dly/dur/hl は meta d.anims[anim_id] から runtime 取得。

				# tween logic
				scoreboard players remove @s <%OBJECTIVES.TWEEN_DURATION()%> 1
				execute if score @s <%OBJECTIVES.TWEEN_DURATION()%> matches 1.. run return 1
				execute if score @s <%OBJECTIVES.TWEEN_DURATION()%> matches 0 on passengers store result entity @s interpolation_duration int 1 run scoreboard players get #<%blueprint_id.replace(':', '.')%> <%OBJECTIVES.DUR(blueprint_id)%>

				# last_frame_effects patch (hl=1b の anim で frame=-1 のとき = loop+delay=0+副作用持ち最終 frame)
				$execute if data storage <%project_storage.replace(':', '.')%>:meta d.anims[$(anim_id)] {hl:1b} if score @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> matches -1 run function <%blueprint_id%>/animations/_lfx_dispatch {anim_id: $(anim_id)}

				# apply current frame (storage 経由で _zzz_apply_frame に流す)
				data remove storage <%project_storage.replace(':', '.')%>:tmp d
				$data modify storage <%project_storage.replace(':', '.')%>:tmp d.anim_id set value $(anim_id)
				execute store result storage <%project_storage.replace(':', '.')%>:tmp d.frame int 1 run scoreboard players get @s <%OBJECTIVES.FRAME_BP(blueprint_id)%>
				function <%blueprint_id%>/animations/_zzz_apply_frame with storage <%project_storage.replace(':', '.')%>:tmp d

				# loop / hold / once 判定 (runtime 動的)。 dur / dly は meta から score にロードして比較。
				$execute store result score #dur <%OBJECTIVES.I()%> run data get storage <%project_storage.replace(':', '.')%>:meta d.anims[$(anim_id)].dur
				$execute store result score #dly <%OBJECTIVES.I()%> run data get storage <%project_storage.replace(':', '.')%>:meta d.anims[$(anim_id)].dly

				# loop モード (lp=1b) : 限界 = dur - 2 + dly。 dly=0 なら frame=-1、 dly>0 なら frame=0。
				scoreboard players operation #limit <%OBJECTIVES.I()%> = #dur <%OBJECTIVES.I()%>
				scoreboard players operation #limit <%OBJECTIVES.I()%> += #dly <%OBJECTIVES.I()%>
				scoreboard players remove #limit <%OBJECTIVES.I()%> 2
				$execute if data storage <%project_storage.replace(':', '.')%>:meta d.anims[$(anim_id)] {lp:1b} if score @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> >= #limit <%OBJECTIVES.I()%> if score #dly <%OBJECTIVES.I()%> matches 0 run return run scoreboard players set @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> -1
				$execute if data storage <%project_storage.replace(':', '.')%>:meta d.anims[$(anim_id)] {lp:1b} if score @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> >= #limit <%OBJECTIVES.I()%> if score #dly <%OBJECTIVES.I()%> matches 1.. run return run scoreboard players set @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> 0

				# hold モード (lp=2b) : 限界 = dur - 1。 達したら current_anim=-1 (pause、 純正 line 320 の pause)。
				scoreboard players operation #limit <%OBJECTIVES.I()%> = #dur <%OBJECTIVES.I()%>
				scoreboard players remove #limit <%OBJECTIVES.I()%> 1
				$execute if data storage <%project_storage.replace(':', '.')%>:meta d.anims[$(anim_id)] {lp:2b} if score @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> >= #limit <%OBJECTIVES.I()%> run return run scoreboard players set @s <%OBJECTIVES.CURRENT_ANIM(blueprint_id)%> -1

				# once モード (lp=0b) : 限界 = dur - 1。 達したら _once_finish で停止 + frame=0 反映。
				$execute if data storage <%project_storage.replace(':', '.')%>:meta d.anims[$(anim_id)] {lp:0b} if score @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> >= #limit <%OBJECTIVES.I()%> run return run function <%blueprint_id%>/animations/_once_finish {anim_id: $(anim_id)}

				scoreboard players add @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> 1
			}

			function _once_finish {
				# ARGS: {anim_id: int}
				# once モード終端処理 (純正 line 326-332 の block loop_mode_stop 集約版)。
				scoreboard players set @s <%OBJECTIVES.CURRENT_ANIM(blueprint_id)%> -1
				scoreboard players set @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> 0
				tag @s add <%TAGS.TRANSFORMS_ONLY()%>
				$execute at @s run function <%blueprint_id%>/animations/_zzz_set_frame {anim_id: $(anim_id), frame: 0}
				tag @s remove <%TAGS.TRANSFORMS_ONLY()%>
			}

			function _lfx_dispatch {
				# ARGS: {anim_id: int}
				# last_frame_effects dispatch。 _zzz_on_tick から hl=1b かつ frame=-1 のときに呼ばれる。
				# anim 別の _lfx/<anim_id>.mcfunction (hl=1b の anim のみ生成) を呼んで最終 frame の
				# locator/variant/function を再実行 + frame を +1 (純正 function_keyframe_loop_patch 相当)。
				$function <%blueprint_id%>/animations/_lfx/$(anim_id)
				scoreboard players add @s <%OBJECTIVES.FRAME_BP(blueprint_id)%> 1
			}
		}
	}
}

function summon {
	#Args: {args:{variant?: string, animation?: string, frame?: int, start_animation?: boolean}}
	# frame is ignored unless animation is specified.
	data modify storage <%temp_storage%> args set value {variant:'', animation:'', frame: 0}
	$execute store success score #success <%OBJECTIVES.I()%> run data modify storage <%temp_storage%> args set value $(args)

	IF (!has_animations && debug_mode) {
		execute if data storage <%temp_storage%> args.animation run return run \
			tellraw @a <%TELLRAW.ANIMATION_ARG_NO_RIG_ANIMATIONS()%>
		execute if data storage <%temp_storage%> args.frame run return run \
			tellraw @a <%TELLRAW.FRAME_ARG_NO_RIG_FRAMES()%>
	}

	summon minecraft:item_display ~ ~ ~ { \
		Tags:<%root_entity_tags%>, \
		teleport_duration: 0, \
		interpolation_duration: <%interpolation_duration%>, \
		Passengers:<%root_entity_passengers%>, \
		CustomName: '<%ENTITY_NAMES.ROOT(blueprint_id)%>', \
	}
	execute as @e[ \
		type=minecraft:item_display, \
		tag=<%TAGS.PROJECT_ROOT(blueprint_id)%>, \
		tag=<%TAGS.NEW()%>, \
		limit=1, distance=..0.01 \
	] run block zzz/summon/as_root_entity {
		execute store result score @s <%OBJECTIVES.ID()%> run scoreboard players add aj.last_id <%OBJECTIVES.ID()%> 1

		data_manager init prep read
		# Data manager init runs gu:get_entity_uuid_string. So we don't need to call it again here.
		# function animated_java:global/gu/get_entity_uuid_string
		data modify storage <%temp_storage%> entry.data.uuids append from storage <%gu_storage%> out
		data modify storage <%temp_storage%> entry.data.root_uuid set from storage <%gu_storage%> out

		data modify storage <%temp_storage%> entry.data.blueprint_id set value "<%blueprint_id%>"
		data modify storage <%temp_storage%> entry.data.rig_hash set value "<%rig_hash%>"

		# Align the position and rotation of the root with the command context.
		tp @s ~ ~ ~ ~ ~

		REPEAT (Object.values(rig.nodes).filter(node => node.type === 'locator' && node.config?.use_entity)) as locator {
			summon <%locator.config.entity_type%> \
				^<%roundTo(locator.default_transform.pos[0], 10)%> \
				^<%roundTo(locator.default_transform.pos[1], 10)%> \
				^<%roundTo(locator.default_transform.pos[2], 10)%> \
				{Tags:<%getNodeTags(locator, rig)%>}
			execute \
				as @e[ \
					type=<%locator.config.entity_type%>, \
					tag=<%TAGS.PROJECT_LOCATOR_NAMED(blueprint_id, locator.storage_name)%>, \
					tag=<%TAGS.NEW()%>, \
					limit=1, distance=..<%Math.ceil(locator.max_distance + 0.5)%> \
				] \
			run block as_locator/<%locator.storage_name%> {
			# run block ../as_locator/<%locator.storage_name%> {
				tag @s remove <%TAGS.NEW()%>
				data modify entity @s CustomName set value '<%ENTITY_NAMES.NODE(blueprint_id, locator.type, locator.storage_name)%>'
				function animated_java:global/gu/get_entity_uuid_string
				scoreboard players operation @s <%OBJECTIVES.ID()%> = aj.last_id <%OBJECTIVES.ID()%>
			}
			data modify storage <%temp_storage%> entry.data.uuids append from storage <%gu_storage%> out
			data modify storage <%temp_storage%> entry.data.uuids_by_name.<%locator.storage_name%> set from storage <%gu_storage%> out
			data modify storage <%temp_storage%> entry.data.locators.<%locator.storage_name%>.uuid set from storage <%gu_storage%> out
		}

		REPEAT (Object.values(rig.nodes).filter(node => node.type === 'camera')) as camera {
			summon minecraft:item_display \
				^<%roundTo(camera.default_transform.pos[0], 10)%> \
				^<%roundTo(camera.default_transform.pos[1], 10)%> \
				^<%roundTo(camera.default_transform.pos[2], 10)%> \
				{Tags:<%getNodeTags(camera, rig)%>, teleport_duration: 2}
			execute \
				as @e[ \
					type=minecraft:item_display, \
					tag=<%TAGS.PROJECT_CAMERA_NAMED(blueprint_id, camera.storage_name)%>, \
					tag=<%TAGS.NEW()%>, \
					limit=1, distance=..<%Math.ceil(camera.max_distance + 0.5)%> \
				] \
			run block as_camera/<%camera.storage_name%> {
			# run block ../as_camera/<%camera.storage_name%> {
				tag @s remove <%TAGS.NEW()%>
				data modify entity @s CustomName set value '<%ENTITY_NAMES.NODE(blueprint_id, camera.type, camera.storage_name)%>'
				function animated_java:global/gu/get_entity_uuid_string
				scoreboard players operation @s <%OBJECTIVES.ID()%> = aj.last_id <%OBJECTIVES.ID()%>
			}
			data modify storage <%temp_storage%> entry.data.uuids append from storage <%gu_storage%> out
			data modify storage <%temp_storage%> entry.data.uuids_by_name.<%camera.storage_name%> set from storage <%gu_storage%> out
			data modify storage <%temp_storage%> entry.data.cameras.<%camera.storage_name%>.uuid set from storage <%gu_storage%> out
		}

		REPEAT (Object.values(rig.nodes).filter(node => BONE_TYPES.includes(node.type))) as node {
			execute \
				on passengers \
				if entity @s[tag=<%TAGS.PROJECT_NODE_NAMED(blueprint_id, node.storage_name)%>] \
			run block as_node/<%node.storage_name%> {
				data modify entity @s CustomName set value '<%ENTITY_NAMES.NODE(blueprint_id, node.type, node.storage_name)%>'
				function animated_java:global/gu/get_entity_uuid_string
				scoreboard players operation @s <%OBJECTIVES.ID()%> = aj.last_id <%OBJECTIVES.ID()%>
			}

			data modify storage <%temp_storage%> entry.data.uuids append from storage <%gu_storage%> out
			data modify storage <%temp_storage%> entry.data.uuids_by_name.<%node.storage_name%> set from storage <%gu_storage%> out
		}

		IF (has_entity_locators) {
			REPEAT (Object.values(rig.nodes).filter(node => node.type === 'locator' && node.config?.use_entity)) as locator {
				block { with storage <%temp_storage%> entry.data.locators.<%locator.storage_name%>
					# Track any custom entities on the locator.
					$execute at @s as $(uuid) at @s run function animated_java:global/util/get_entity_stack_uuids
				}
				data modify storage <%temp_storage%> entry.data.uuids append from storage <%temp_storage%> uuids
			}
		}

		function <%blueprint_id%>/zzz/set_default_pose

		data_manager write

		# Variant Arguement
		IF (Object.keys(rig.variants).length > 1) {
			execute if data storage <%temp_storage%> args.variant run block variant_arg/process { with storage <%temp_storage%> args
				scoreboard players set #success <%OBJECTIVES.I()%> 0
				# If the variant argument is *explicitly* set to an empty string, return an error.
				execute if data storage <%temp_storage%> {args:{variant:''}} run return run block if_empty {
					# Tell the user that the variant cannot be empty.
					tellraw @a <%TELLRAW.ARGUMENT_CANNOT_BE_EMPTY('variant')%>
					function <%blueprint_id%>/remove/this/without_on_remove_function
				}
				# Attempt to apply the requested variant.
				# We get the success of the `try_apply` function in just in case the user's arguments are *very* wrong.
				execute store success score #success <%OBJECTIVES.I()%> run block try_apply { with storage <%temp_storage%> args
					$execute if function <%blueprint_id%>/variants/$(variant)/apply run return 1
					# If the apply function fails, the variant doesn't exist, so we return an error.
					return fail
				}
				# If the apply function failed, return an error.
				execute unless score #success <%OBJECTIVES.I()%> matches 1 run return run block invalid_variant {
					# Tell the user that the provided variant doesn't exist, remove the rig, and list all available variants for this rig.
					tellraw @a <%TELLRAW.INVALID_VARIANT(rig.variants)%>
					function <%blueprint_id%>/remove/this/without_on_remove_function
				}
				scoreboard players set #success <%OBJECTIVES.I()%> 1
			}
		} ELSE {
			execute if data storage <%temp_storage%> args.variant run block zzz/variant_arg/no_variants_warning {
				tellraw @a <%TELLRAW.NO_VARIANTS()%>
				function <%blueprint_id%>/remove/this/without_on_remove_function
				scoreboard players set #success <%OBJECTIVES.I()%> 0
			}
		}
		execute if score #success <%OBJECTIVES.I()%> matches 0 run return fail

		IF (has_animations) {
			# Animation Argument
			# If the animation argument is provided, attempt to apply the animation.
			execute if data storage <%temp_storage%> args.animation run block animation_arg/process { with storage <%temp_storage%> args
				scoreboard players set #success <%OBJECTIVES.I()%> 0
				# If the animation argument is *explicitly* set to an empty string, return an error.
				execute if data storage <%temp_storage%> {args:{animation:''}} run return run block if_empty {
					tellraw @a <%TELLRAW.ARGUMENT_CANNOT_BE_EMPTY('animation')%>
					function <%blueprint_id%>/remove/this/without_on_remove_function
				}
				# Automatically set the frame argument to 0 if the frame argument is not provided.
				# Takes advantage of `store result score` setting the score to 0 if the command fails.
				execute \
					store result storage <%temp_storage%> args.frame int 1 \
					store result score #frame <%OBJECTIVES.I()%> \
				run \
					data get storage <%temp_storage%> args.frame
				# If the frame argument is negative, return an error.
				execute if score #frame <%OBJECTIVES.I()%> matches ..-1 run return run block no_negative {
					# Tell the user that the frame argument cannot be negative.
					tellraw @a <%TELLRAW.FRAME_CANNOT_BE_NEGATIVE()%>
					function <%blueprint_id%>/remove/this/without_on_remove_function
				}
				# Attempt to apply the animation frame.
				execute store success score #success <%OBJECTIVES.I()%> run block try_set_frame { with storage <%temp_storage%> args
					# Make sure we're only applying transforms when setting the summon pose.
					tag @s add <%TAGS.TRANSFORMS_ONLY()%>
					IF (tsb_optimized_export) {
						# TSB 集約版 : wrapper `<anim>/set_frame` を呼ぶ (引数 frame は args から流れる、
						# wrapper 側で anim_id 埋め込み + _set_frame に dispatch)。 純正の zzz/set_frame
						# (passenger context) ではなく root context で OK。
						$execute store success score #success <%OBJECTIVES.I()%> run function <%blueprint_id%>/animations/$(animation)/set_frame with storage <%temp_storage%> args
					} ELSE {
						$execute store success score #success <%OBJECTIVES.I()%> run function <%blueprint_id%>/animations/$(animation)/zzz/set_frame with storage <%temp_storage%> args
					}
					tag @s remove <%TAGS.TRANSFORMS_ONLY()%>
					execute if score #success <%OBJECTIVES.I()%> matches 1 run return 1
					# If the set_frame function fails, the animation doesn't exist, so we return an error.
					return fail
				}
				# If the set_frame function failed, return an error.
				execute unless score #success <%OBJECTIVES.I()%> matches 1 run return run block invalid_animation {
					# Tell the user that the provided animation doesn't exist, remove the rig, and list all available animations for this rig.
					tellraw @a <%TELLRAW.INVALID_ANIMATION(animations)%>
					function <%blueprint_id%>/remove/this/without_on_remove_function
				}

				# If the animation is successfully applied, and the start_animation argument is set to true, start the animation.
				execute if data storage <%temp_storage%> {args:{start_animation: true}} run block start_animation { with storage <%temp_storage%> args
					$function <%blueprint_id%>/animations/$(animation)/resume
				}
				scoreboard players set #success <%OBJECTIVES.I()%> 1
			}
			execute if score #success <%OBJECTIVES.I()%> matches 0 run return fail
		}

		IF (has_locators || has_cameras) {
			function <%blueprint_id%>/root/on_tick/transform_floating_entities
		}
		execute on passengers run tp @s ~ ~ ~ ~ ~

		# Apply teleport duration
		data modify entity @s teleport_duration set value <%teleportation_duration%>
		execute on passengers run data modify entity @s teleport_duration set value <%teleportation_duration%>

		IF (has_entity_locators) {
			REPEAT (Object.values(rig.nodes).filter(node => node.type === 'locator' && node.config?.use_entity && node.config.on_summon_function)) as locator {
				block { with storage <%temp_storage%> entry.data.locators.<%locator.storage_name%>
					$execute at @s as $(uuid) at @s run block on_summon/custom_<%locator.type + '_' + locator.storage_name%> {
						<%%
							emit.mcb(locator.config.on_summon_function)
						%%>
					}
				}
			}
		}

		REPEAT (Object.values(rig.nodes).filter(node => BONE_TYPES.includes(node.type) && node.on_summon_function?.trim())) as node {
			execute \
				on passengers if entity @s[tag=<%TAGS.PROJECT_NODE_NAMED(blueprint_id, node.storage_name)%>] \
			run block on_summon/<%node.type + '_' + node.storage_name%> {
				<%%
					emit.mcb(node.on_summon_function.trim())
				%%>
			}
		}

		IF (on_summon_function) {
			execute at @s run block on_summon/rig {
				<%%
					emit.mcb(on_summon_function)
				%%>
			}
		}

		IF (tsb_optimized_export && has_animations) {
			# Phase C : 各 passenger に bone_id / locator_id score を set。
			# sentinel -1 を全 passenger に初期 set してから該当 passenger のみ上書き (未割当 passenger は -1 のまま)。
			# apply 側は `matches 0..` で -1 を弾くことで「未割当 = skip」 を成立させる。
			execute on passengers run scoreboard players set @s <%OBJECTIVES.BONE_ID(blueprint_id)%> -1
			execute on passengers run scoreboard players set @s <%OBJECTIVES.LOCATOR_ID(blueprint_id)%> -1
			<%%
				Object.values(rig.nodes)
					.filter(n => BONE_TYPES.includes(n.type))
					.forEach((node, i) => {
						emit(`execute on passengers if entity @s[tag=${TAGS.PROJECT_NODE_NAMED(blueprint_id, node.storage_name)}] run scoreboard players set @s ${OBJECTIVES.BONE_ID(blueprint_id)} ${i}`)
					})
				Object.values(rig.nodes)
					.filter(n => n.type === 'locator' || n.type === 'camera')
					.forEach((node, i) => {
						emit(`execute on passengers if entity @s[tag=${TAGS.PROJECT_NODE_NAMED(blueprint_id, node.storage_name)}] run scoreboard players set @s ${OBJECTIVES.LOCATOR_ID(blueprint_id)} ${i}`)
					})
			%%>
		}

		# Remove the NEW tag from the root entity, and it's passengers.
		tag @s remove <%TAGS.NEW()%>
		execute on passengers run tag @s remove <%TAGS.NEW()%>
	}
}

function as_node {
	#ARGS: {name: string, command: string}
	debug assert executed_as_root_entity <%TAGS.PROJECT_ROOT(blueprint_id)%>
	data remove storage <%temp_storage%> args
	$data modify storage <%temp_storage%> args merge value {name:'$(name)', command:'$(command)', uuid:'+MISSING_UUID+'}

	IF (debug_mode) {
		execute if data storage <%temp_storage%> {args:{name:''}} run return run tellraw @a <%TELLRAW.ARGUMENT_CANNOT_BE_EMPTY('name')%>
		execute if data storage <%temp_storage%> {args:{command:''}} run return run tellraw @a <%TELLRAW.ARGUMENT_CANNOT_BE_EMPTY('command')%>
	}

	data_manager prep read

	block zzz/as_node/as_data { with storage <%temp_storage%> args
		$data modify storage <%temp_storage%> args.uuid set from storage <%temp_storage%> entry.data.uuids_by_name.$(name)
		IF (debug_mode) {
			scoreboard players set #aj.check <%OBJECTIVES.I()%> 0
		}
		block execute_as_uuid { with storage <%temp_storage%> args
			IF (debug_mode) {
				# If the function successfully instantiated, the provided command is valid.
				scoreboard players set #aj.check <%OBJECTIVES.I()%> 1
			}
			$execute as $(uuid) run return run $(command)
			IF (debug_mode) {
				# If the entity with the provided UUID doesn't exist, the node wasn't found.
				tellraw @a <%TELLRAW.NODE_ENTITY_NOT_FOUND()%>
			}
		}
		IF (debug_mode) {
			execute if score #aj.check <%OBJECTIVES.I()%> matches 0 run tellraw @a <%TELLRAW.NODE_COMMAND_FAILED_TO_EXECUTE()%>
		}
	}
}

